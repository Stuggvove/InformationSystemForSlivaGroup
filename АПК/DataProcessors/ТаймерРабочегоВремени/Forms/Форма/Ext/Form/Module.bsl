&НаСервере
Процедура ОбновитьИсториюНаСервере()
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |    УРВ.ВремяНачала,
    |    УРВ.ВремяОкончания,
    |    УРВ.ТипЗаписи КАК Тип,
    |    УРВ.Задача,
    |    УРВ.Комментарий,
    |    УРВ.Длительность
    |ИЗ
    |    РегистрСведений.УчетРабочегоВремени КАК УРВ
    |ГДЕ
    |    УРВ.Пользователь = &Пользователь
    |    И УРВ.Дата = &Дата
    |УПОРЯДОЧИТЬ ПО
    |    УРВ.ВремяНачала";
    
    Запрос.УстановитьПараметр("Пользователь", ПараметрыСеанса.ТекущийСотрудник);
    Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДата()));
    
    ИсторияЗаСегодня.Загрузить(Запрос.Выполнить().Выгрузить());
    
КонецПроцедуры

&НаСервере
Функция ПолучитьТипПерерыв()
    Возврат Перечисления.ТипЗаписиВремени.Перерыв;
КонецФункции

&НаСервере
Функция ПолучитьСписокТипов()
	
	СписокТипов = Новый СписокЗначений;
	
	Для Каждого ЗначениеПеречисления Из Перечисления.ТипЗаписиВремени Цикл 
		СписокТипов.Добавить(ЗначениеПеречисления);
	КонецЦикла;
	
	Возврат СписокТипов;
	
КонецФункции

&НаКлиенте
Процедура ВозобновитьПослеВыбораТипа(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт 
	
	Если ВыбранныйЭлемент = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ВозобновитьСТипом(ВыбранныйЭлемент.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВозобновитьСТипом(Тип)
	
	// Закрываем перерыв
    ВремяОкончания = ТекущаяДата();
    ЗакрытьАктивнуюЗапись(СтартВремени, ВремяОкончания);
	
	
    // Стартуем новую запись с предыдущим типом
    НовыйСтарт	 = ТекущаяДата();
    СтартВремени = НовыйСтарт;
	ТекущийТип	 = Тип;
	
	СохранитьЗапись(СтартВремени, '0001-01-01', 
	ТекущийТип, ТекущаяЗадача, ТекущийКомментарий);
	
	ОбновитьИсториюНаСервере();
	
	Элементы.НажатьВозобновить.Видимость = Ложь;
	
КонецПроцедуры

#КонецОбласти
