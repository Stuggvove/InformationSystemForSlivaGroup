
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МассивНазначений = Новый Массив(); 
	МассивНазначений.Добавить(Тип("ЗадачаСсылка.Созвон")); 
	ОписаниеТипов = Новый ОписаниеТипов(МассивНазначений);

	Элементы.ВедущаяЗадача.ОграничениеТипа = ОписаниеТипов; 
	Объект.ВедущаяЗадача = ОписаниеТипов.ПривестиЗначение(Объект.ВедущаяЗадача);
	
	Объект.СсылкаНаСозвон = "Будет позже";
	
КонецПроцедуры