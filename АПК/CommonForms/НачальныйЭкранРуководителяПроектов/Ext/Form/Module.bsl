
#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	
	ВывестиПриветствие();
	
	НазваниеДня = СтрРазделить("Понедельник,Вторник,Среда,Четверг,Пятница,Суббота,Воскресенье", 
	",")[ДеньНедели(ТекущаяДата()) - 1];
	
	Элементы.СегодняшняяДата.Заголовок = "Сегодня: " + НазваниеДня + "," 
	+ Символы.ПС + Строка((Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy; ДЛФ=DDT")));
	
	КоличествоЗадачСотрудника = МодульСотрудников.ПосчитатьЗадачиСотрудника();
	
	Элементы.КоличествоЗадач.Заголовок = "У вас на сегодня " + КоличествоЗадачСотрудника + " " 
	+ СклонениеЗадач(КоличествоЗадачСотрудника) + "!";
	
	ПросроченныхЗадач = МодульЗадач.ПолучитьКоличествоПросроченныхЗадач();
	
	Элементы.ПросроченоЗадач.Заголовок = "Просрочено: "
	+ ПросроченныхЗадач + " " + СклонениеЗадач(ПросроченныхЗадач) + "!";
	
КонецПроцедуры

