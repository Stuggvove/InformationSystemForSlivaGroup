#Область ВспомогательныеФункцииИПроцедуры

&НаСервере
Процедура ВывестиПриветствие(ДлинаИмени)
	
	Счет			  = 0;
	Час				  = Час(ТекущаяДата());
	МассивПриветствий = МодульПриветсвий.СформироватьТаблицуПриветствий();
	Пользователь	  = Прав(ПользователиИнформационнойБазы.ТекущийПользователь().Имя, ДлинаИмени);
	
	Для Каждого Правило Из МассивПриветствий Цикл 
		
		Если Счет <> 3 Тогда 
			
			Если Час >= Правило.Начало И Час < Правило.Конец Тогда 
				Элементы.Приветствие.Заголовок = Правило.Текст + Пользователь + "!";
			КонецЕсли;
			
		Иначе
			
			Если Час >= Правило.Начало Или Час < Правило.Конец Тогда 
				Элементы.Приветствие.Заголовок = Правило.Текст + Пользователь + "!";
			КонецЕсли;
			
		КонецЕсли;
		
		Счет = Счет + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СклонениеЗадач(Количество)
	
	Остаток11_19 = Количество % 100;
	Остаток1_9   = Количество % 10;
	
	Если Остаток11_19 >= 11 И Остаток11_19 <= 19 Тогда
		Возврат "задач";
	ИначеЕсли Остаток1_9 = 1 Тогда
		Возврат "задача";
	ИначеЕсли Остаток1_9 >= 2 И Остаток1_9 <= 4 Тогда
		Возврат "задачи";
	Иначе
		Возврат "задач";
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ОбновитьДанныеНаСервере()
	
	НазваниеДня = СтрРазделить("Понедельник,Вторник,Среда,Четверг,Пятница,Суббота,Воскресенье", 
	",")[ДеньНедели(ТекущаяДата()) - 1];
	
	Элементы.ТекДата.Заголовок = "Сегодня: " + НазваниеДня + "," + Символы.ПС 
	+ Строка((Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy; ДЛФ=DDT")));
	
	КоличествоЗадач = МодульСотрудников.ПосчитатьЗадачиСотрудника();
	
	Элементы.КоличествоЗадач.Заголовок = "У вас на сегодня " + КоличествоЗадач + " " 
	+ СклонениеЗадач(КоличествоЗадач) + "!";
	
	ХранениеБаланса = МодульБанковскойКартыСервер.ЗаписатьБалансКарты();
	
	Элементы.БалансКартыНадпись.Заголовок = "Баланс расчетного счета: " 
	+ Символы.ПС + Строка(ХранениеБаланса);
	
	КоличествоПросроченныхЗадач 
	= МодульЗадач.ПолучитьКоличествоПросроченныхЗадач();
	
	Элементы.КоличествоПросрочки.Заголовок = "Просрочено " + КоличествоПросроченныхЗадач 
	+ " " + СклонениеЗадач(КоличествоПросроченныхЗадач) + "!";
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанные()
	
	СчетчикСекунд = СчетчикСекунд + 1;
	
	Если СчетчикСекунд % 15 = 0 Тогда 
		ОбновитьДанныеНаСервере();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

