
#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Пользователь = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	
	Если РольДоступна("ПолныеПрава") И Пользователь = "Добрынин Андрей" Тогда 
		
		Элементы.Все_Администрирование.Видимость = Истина;
		Элементы.Администрирование.Видимость = Истина;
		
	Иначе 
		
		Элементы.Все_Администрирование.Видимость = Ложь;
		Элементы.Администрирование.Видимость = Ложь;
		
	КонецЕсли;
	
	Если Пользователь = "Савченков Иван" Тогда 
		
		ДлинаИмени = 4;
		
	Иначе 
		
		ДлинаИмени = 6;
		
		Элементы.ЗаписатьБалансКарты.Видимость = Истина;
		Элементы.ЗаписатьБалансКарты1.Видимость = Истина;
		
	КонецЕсли;
	
	ВывестиПриветствие(ДлинаИмени);
	
	БалансКарты = МодульБанковскойКартыСервер.ЗаписатьБалансКарты();
	
	Элементы.БалансКартыНадпись.Заголовок = "Баланс расчетного счета: " 
	+ Символы.ПС + Строка(БалансКарты);
	
	НазваниеДня = СтрРазделить("Понедельник,Вторник,Среда,Четверг,Пятница,Суббота,Воскресенье", 
	",")[ДеньНедели(ТекущаяДата()) - 1];
	
	Элементы.ТекДата.Заголовок = "Сегодня: " + НазваниеДня + "," + Символы.ПС 
	+ Строка((Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy; ДЛФ=DDT")));
	
	КоличествоЗадач = МодульСотрудников.ПосчитатьЗадачиСотрудника();
	
	Элементы.КоличествоЗадач.Заголовок = "У вас на сегодня " + КоличествоЗадач + " " 
	+ СклонениеЗадач(КоличествоЗадач) + "!";
	
	КоличествоПросроченныхЗадач 
	= МодульЗадач.ПолучитьКоличествоПросроченныхЗадач();
	
	Элементы.КоличествоПросрочки.Заголовок = "Просрочено " + КоличествоПросроченныхЗадач 
	+ " " + СклонениеЗадач(КоличествоПросроченныхЗадач) + "!";
	
	//МодульTelegram.ЗагрузитьСообщенияИзТелеграм();
	
КонецПроцедуры

