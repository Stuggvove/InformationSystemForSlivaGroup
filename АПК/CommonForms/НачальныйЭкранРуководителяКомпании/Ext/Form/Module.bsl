КонецПроцедуры

&НаСервере
Процедура ЗаписатьБалансКартыНаСервере()
	
	Константы = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиНаКартеОстатки.НаименованиеТранзакции КАК НаименованиеТранзакции,
	|	ОстаткиНаКартеОстатки.Валюта КАК Валюта,
	|	ОстаткиНаКартеОстатки.СуммаСписанияОстаток КАК СуммаСписанияОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиНаКарте.Остатки КАК ОстаткиНаКартеОстатки";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл 	
		Константы = Константы + Выборка.СуммаСписанияОстаток;			
	КонецЦикла;
	
	Константы.БалансКарты.Установить(Константы);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьБалансКарты(Команда)
	ЗаписатьБалансКартыНаСервере();
КонецПроцедуры

#КонецОбласти
