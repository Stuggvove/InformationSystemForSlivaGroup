Процедура  ЗагрузитьСообщенияИзТелеграм() Экспорт 
	
	СтруктураJSON = GetUpdates(Константы.ПоследнийНомерСообщения.Получить() + 1);
	
	Если Не СтруктураJSON.Свойство("ok") Тогда 
		Возврат;
	КонецЕсли;
	
	Если Не СтруктураJSON.ok Тогда 
		Возврат;
	КонецЕсли;
	
	Если Не СтруктураJSON.Свойство("result") Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого Сообщение Из СтруктураJSON.result Цикл
		
		Если Сообщение.Свойство("update_id") Тогда 
			Константы.ПоследнийНомерСообщения.Установить(Сообщение.update_id);
		КонецЕсли;
		
		Если Не Сообщение.Свойство("message") Тогда 
			Продолжить;
		КонецЕсли;
		
		Если Не Сообщение.message.Свойство("text") Тогда 
			
			Если Сообщение.message.Свойство("from") Тогда 	
				SendMessage(Формат(Сообщение.message.from.id, "ЧРГ=''; ЧГ=0"), "Бот принимает только текст!");
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		Если Не Сообщение.message.Свойство("chat") Тогда 
			Продолжить;
		КонецЕсли;
		
		НовоеСообщение = Сообщение.message.chat;
		IDПользователя = Формат(НовоеСообщение.id, "ЧРГ=''; ЧГ=0");
		
		НайденнаяСсылка = Справочники.УчетныеЗаписиTelegram.НайтиПоРеквизиту("ID", IDПользователя);
		
		Если НайденнаяСсылка = Справочники.УчетныеЗаписиTelegram.ПустаяСсылка() Тогда 
			
			НайденнаяСсылка = Справочники.УчетныеЗаписиTelegram.СоздатьЭлемент();
			НайденнаяСсылка.ID = IDПользователя;
			НайденнаяСсылка.Наименование = НовоеСообщение.first_name;
			НайденнаяСсылка.Записать();
			
		КонецЕсли;
		
		НоваяЗапись				   = РегистрыСведений.СообщенияTelegram.СоздатьМенеджерЗаписи();
		НоваяЗапись.IDСообщения	   = Сообщение.update_id;
		НоваяЗапись.ТекстСообщения = Сообщение.message.text;
		НоваяЗапись.ДатаСообщения  = ТекущаяДата();
		НоваяЗапись.УчетнаяЗапись  = НайденнаяСсылка;
		
		НоваяЗапись.Записать();
		
		ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь().ПолноеИмя;
		
		ТекстСообщения = СокрЛП(Сообщение.message.text);
		
		Если ТекстСообщения = "/start" Тогда 
			SendMessage(IDПользователя, "Привет! Выберите действие:", СгенерироватьКлавиатуру());
			
		ИначеЕсли ТекстСообщения = "Показать текущий баланс" Тогда
			
			Если РольДоступна("ПолныеПрава") И ТекущийПользователь <> "Добрынин Андрей Дмитриевич" Тогда
				
				SendMessage(IDПользователя, "Ваш текущий баланс карты: " + Константы.БалансКарты.Получить());
				
			Иначе 
				
				SendMessage(IDПользователя, "Вам недоступна эта информация");
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция GetUpdates(offset = 0, limit = 0, timeout = 0) Экспорт 
	
	ПараметрыМетода = Новый Структура;
	
	Если ЗначениеЗаполнено(offset) Тогда 
		ПараметрыМетода.Вставить("offset", Формат(offset, "ЧРГ=''; ЧГ=0"));
	КонецЕсли;
	
	Результат = МодульWEBHTTP.ОтправитьHTTPЗапрос(Константы.TelegramТокен.Получить(), "getUpdates", ПараметрыМетода);
	Возврат Результат;
	
КонецФункции

Функция SendMessage(chat_id, text, reply_markup = Неопределено, parse_mode = Неопределено) Экспорт 
	
	ПараметрыМетода = Новый Структура;
	
	ПараметрыМетода.Вставить("chat_id", Формат(chat_id, "ЧРГ=''; ЧГ=0"));
	ПараметрыМетода.Вставить("text", СокрЛП(text));
	
	Если reply_markup <> Неопределено Тогда 
		ПараметрыМетода.Вставить("reply_markup", reply_markup);
	КонецЕсли;
	
	Если parse_mode <> Неопределено Тогда 
		ПараметрыМетода.Вставить("parse_mode", parse_mode);
	КонецЕсли;
	
	Результат = МодульWEBHTTP.ОтправитьHTTPЗапрос(Константы.TelegramТокен.Получить(), "sendMessage", ПараметрыМетода);
	Возврат Результат;
	
КонецФункции

Функция SetWebhook(url) Экспорт 
	
	ПараметрыМетода = Новый Структура;
	
	ПараметрыМетода.Вставить("url", СокрЛП(url));
	
	Результат = МодульWEBHTTP.ОтправитьHTTPЗапрос(Константы.TelegramТокен.Получить(), "setWebhook", ПараметрыМетода);
	Возврат Результат;
	
КонецФункции

