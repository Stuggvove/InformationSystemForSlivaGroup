КонецФункции

Функция SendDocument(chat_id, document, caption = Неопределено) Экспорт 
	
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("chat_id", Формат(chat_id, "ЧРГ=''; ЧГ=0"));
	
	Если ЗначениеЗаполнено(caption) Тогда 
		ПараметрыМетода.Вставить("caption", caption);
	КонецЕсли;
		
	Результат = МодульWEBHTTP.ОтправитьHTTPЗапрос(Константы.TelegramТокен.Получить(), "sendDocument", ПараметрыМетода);
	Возврат Результат;
	
КонецФункции

Функция СгенерироватьКлавиатуру() Экспорт 
	
	СтрокаКнопок_1 = Новый Массив;
	СтрокаКнопок_1.Добавить("Показать текущий баланс");
	
	Клавиатура = Новый Массив;
	Клавиатура.Добавить(СтрокаКнопок_1);
	
	РезультатКлавиатуры = Новый Структура;
	РезультатКлавиатуры.Вставить("keyboard", Клавиатура);
	РезультатКлавиатуры.Вставить("resize_keyboard", Истина);
	РезультатКлавиатуры.Вставить("one_time_keyboard", Ложь);
	
	Возврат РезультатКлавиатуры;
	
КонецФункции

Процедура ОбработатьВходящееСообщение(Сообщение) Экспорт 
	
	Если Не Сообщение.Свойство("message") Тогда 
		Возврат;
	КонецЕсли;
	
	Если Не Сообщение.message.Свойство("text") Тогда 
		
		Если Сообщение.message.Свойство("from") Тогда 
			SendMessage(Формат(Сообщение.message.from.id, "ЧРГ=''; ЧГ=0"), "Бот принимает только текст!");	
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если Не Сообщение.message.Свойство("chat") Тогда 
		Возврат;
	КонецЕсли;
	
	IDПользователя  = Формат(Сообщение.message.from.id, "ЧРГ=''; ЧГ=0");
	НайденнаяСсылка = Справочники.УчетныеЗаписиTelegram.НайтиПоРеквизиту("ID", IDПользователя);
	
	Если НайденнаяСсылка = Справочники.УчетныеЗаписиTelegram.ПустаяСсылка() Тогда 
		
		НайденнаяСсылка				 = Справочники.УчетныеЗаписиTelegram.СоздатьЭлемент();
		НайденнаяСсылка.ID			 = IDПользователя;
		НайденнаяСсылка.Наименование = Сообщение.message.chat.first_name;
		
		НайденнаяСсылка.Записать();
		
	КонецЕсли;
	
	НоваяЗапись				   = РегистрыСведений.СообщенияTelegram.СоздатьМенеджерЗаписи();
	НоваяЗапись.IDСообщения	   = Сообщение.update_id;
	НоваяЗапись.ТекстСообщения = Сообщение.message.text;
	НоваяЗапись.УчетнаяЗапись  = НайденнаяСсылка;
	НоваяЗапись.ДатаСообщения  = ТекущаяДата();
	
	НоваяЗапись.Записать();
	
	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь().ПолноеИмя;
	
	ТекстСообщения = СокрЛП(Сообщение.message.text);
	
	Если ТекстСообщения = "/start" Тогда 
		
		SendMessage(IDПользователя, "Привет! Выберите действие:", СгенерироватьКлавиатуру());
		
	ИначеЕсли ТекстСообщения = "Показать текущий баланс" Тогда
		
		Если РольДоступна("ПолныеПрава") И Не ТекущийПользователь = "Добрынин Андрей Дмитриевич" Тогда 
		
			SendMessage(IDПользователя, "Ваш текущий баланс карты: " + Константы.БалансКарты.Получить());
			
		Иначе 
			
			SendMessage(IDПользователя, "У вас недостадочно прав для просмотра этой информации!");
			
		КонецЕсли;
		
	Иначе 
		
		SendMessage(IDПользователя, "Неизвестная команда. Выберите действие:", СгенерироватьКлавиатуру()); 
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УведомитьИнициатораОЗавершении(БизнесПроцесс) Экспорт
    
    ИнициаторСозвона = СокрЛП(ПользователиИнформационнойБазы.ТекущийПользователь().ПолноеИмя);
    Сотрудник = Справочники.Сотрудники.НайтиПоКоду(ИнициаторСозвона);
    
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |	УчетныеЗаписиTelegram.ID КАК ID
    |ИЗ
    |	Справочник.УчетныеЗаписиTelegram КАК УчетныеЗаписиTelegram
    |ГДЕ
    |	ВЫРАЗИТЬ(УчетныеЗаписиTelegram.Сотрудник КАК Справочник.Сотрудники) = &Сотрудник
    |	И НЕ УчетныеЗаписиTelegram.ПометкаУдаления";
    Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
    
    Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Уведомление = "Здравствуйте, " + СокрЛП(ИнициаторСозвона) + "!"
		+ Символы.ПС + "Уведомляю вас, что все сотруднки были оповещены о созвоне!";
		
		SendMessage(Выборка.ID, Уведомление);

    КонецЕсли;
    
КонецПроцедуры