	Результат = МодульWEBHTTP.ОтправитьHTTPЗапрос(Константы.TelegramТокен.Получить(), "deleteWebhook", Неопределено);
	Возврат Результат;
	
КонецФункции

Функция GetWebhookInfo() Экспорт 
	
	ПараметрыМетода = Новый Структура;
	
	Результат = МодульWEBHTTP.ОтправитьHTTPЗапрос(Константы.TelegramТокен.Получить(), "getWebhookInfo", ПараметрыМетода);
