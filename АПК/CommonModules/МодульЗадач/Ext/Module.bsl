
Процедура ОбновитьПросроченныеЗадачи() Экспорт 
	
	ТекущаяДата = ТекущаяДата();
	
	МассивПросроченныхЗадач = ПолучитьЗадачиДляОбновления(Истина, ТекущаяДата);
	ОбновитьПризнакПросрочено(МассивПросроченныхЗадач, Истина);
	
	МассивВосстановленныхЗадач = ПолучитьЗадачиДляОбновления(Ложь, ТекущаяДата);
	ОбновитьПризнакПросрочено(МассивВосстановленныхЗадач, Ложь);
	
	ЗаписьЖурналаРегистрации(
	"ОбновлениеПросроченныхЗадач",
	УровеньЖурналаРегистрации.Информация,
	,,
	"Просрочено: " + МассивПросроченныхЗадач.Количество()
	+ ", Снято: " + МассивВосстановленныхЗадач.Количество());
	
КонецПроцедуры

Функция ПолучитьЗадачиДляОбновления(НужноПросрочить, ТекущаяДата)
	
	Запрос = Новый Запрос;
	
	Если НужноПросрочить Тогда 
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Задача.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.Задача КАК Задача
		|ГДЕ
		|	Задача.ЗадачаПросрочена = ЛОЖЬ
		|	И Задача.СрокИсполнения <> ДАТАВРЕМЯ(1, 1, 1)
		|	И Задача.СрокИсполнения < &ТекущаяДата";
		
	Иначе 
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Задача.Ссылка КАК Ссылка,
		|	Задача.ЗадачаПросрочена КАК ЗадачаПросрочена
		|ИЗ
		|	Задача.Задача КАК Задача
		|ГДЕ
		|	Задача.ЗадачаПросрочена = ИСТИНА
		|	И Задача.СрокИсполнения >= &ТекущаяДата
		|	И Задача.Выполнена = ИСТИНА";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выгрузка = РезультатЗапроса.Выгрузить();
	Колонка  = Выгрузка.ВыгрузитьКолонку("Ссылка");
	
	Возврат Колонка;
	
КонецФункции

Процедура ОбновитьПризнакПросрочено(МассивСсылок, Значение)
	
	Если МассивСсылок.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого Ссылка Из МассивСсылок Цикл 
	
		ОбъектЗадачи = Ссылка.ПолучитьОбъект();
		ОбъектЗадачи.ЗадачаПросрочена = Значение;
		ОбъектЗадачи.ОбменДанными.Загрузка = Истина;
		ОбъектЗадачи.Записать();
		
	КонецЦикла;	
		
КонецПроцедуры

Функция ПолучитьКоличествоПросроченныхЗадач() Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задача.Ссылка КАК Ссылка,
	|	Задача.Выполнена КАК Выполнена,
	|	Задача.Исполнитель КАК Исполнитель,
	|	Задача.ЗадачаПросрочена КАК ЗадачаПросрочена
	|ИЗ
	|	Задача.Задача КАК Задача
	|ГДЕ
	|	Задача.Исполнитель = &Исполнитель
	|	И Задача.ЗадачаПросрочена = ИСТИНА
	|	И Задача.Выполнена = ЛОЖЬ";
	Запрос.УстановитьПараметр("Исполнитель", ПараметрыСеанса.ТекущийСотрудник);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка			 = РезультатЗапроса.Выбрать();
	
	Возврат Выборка.Количество();
	
КонецФункции
