&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Выборка = Справочники.Сотрудники.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		ПользовательИБ = Неопределено;
		
		ВсеПользователи = ПользователиИнформационнойБазы.ПолучитьПользователей();
		
		Для Каждого Польз Из ВсеПользователи Цикл
			
			Если Польз.ПолноеИмя = СокрЛП(Выборка.Код) Тогда
				
				ПользовательИБ = Польз;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ПользовательИБ <> Неопределено Тогда 
			
			СотрудникОбъект = Выборка.ПолучитьОбъект();
			СотрудникОбъект.ИдентификаторПользователяИБ = ПользовательИБ.УникальныйИдентификатор;
			СотрудникОбъект.Записать();
			
		КонецЕсли;
		
	КонецЦикла;		
	
КонецПроцедуры

