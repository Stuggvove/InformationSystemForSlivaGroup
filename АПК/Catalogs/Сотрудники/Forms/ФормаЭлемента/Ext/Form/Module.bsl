
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура СтудентПриИзменении(Элемент)
	
	Отказ = Ложь;
	СтандартнаяОбработка = Истина;
	
	Студент = ПриСозданииНаСервере(Отказ, СтандартнаяОбработка);
	
	Если Студент Тогда 
		//ПредупреждениеАсинх("Заполните карточку студента!");
		Сообщить("Заполните карточку студента!");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Студент = Объект.Студент;
	
	Если Студент Тогда 
		Элементы.КарточкаСтудента.Видимость = Истина;
	Иначе 
		Элементы.КарточкаСтудента.Видимость = Ложь;
	КонецЕсли;
	
	Администратор = "Добрынин Андрей Дмитриевич";
	ТекущийПользователь = ПараметрыСеанса.ТекущийСотрудник.Код;
	
	Если РольДоступна("ПолныеПрава") И ТекущийПользователь = Администратор Тогда 
		Элементы.Администрирование.Видимость = Истина;
	Иначе 
		Элементы.Администрирование.Видимость = Ложь;
	КонецЕсли;
	
	Возврат Студент;
	
КонецФункции

