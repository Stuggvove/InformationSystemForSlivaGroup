&НаСервере
Процедура ЭтапПроектаПриИзмененииНаСервере()
			
	Элементы.ПрогрессБар.Видимость = Ложь;
	
	КодЭтапа = Объект.ЭтапПроекта.Код;
	
	Если КодЭтапа >= 1 И КодЭтапа <= 9 Тогда
		
		Элементы.ПрогрессБар.Картинка = БиблиотекаКартинок["ПрогрессБар_" + КодЭтапа];
		Элементы.ПрогрессБар.Видимость = Истина;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭтапПроектаПриИзменении(Элемент)
	ЭтапПроектаПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Отказ = Ложь;
	СтандартнаяОбработка = Истина;
	
	ПриСозданииНаСервере(Отказ, СтандартнаяОбработка); 
	
КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура ОтредактироватьНазвание(Команда)	
	
	Элементы.Наименование.Видимость = Истина;
	Элементы.ОтредактироватьНазвание.Видимость = Ложь;
	Элементы.ФормаПодтвердитьИзменения.Видимость = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПодтвердитьИзмененияНаСервере()
	
	Отказ = Ложь;
	СтандартрнаяОбработка = Истина;
	
	ЭтотОбъект.Записать();
	Элементы.ОтредактироватьНазвание.Видимость = Истина;
		
	ПриСозданииНаСервере(Отказ, СтандартрнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИзменения(Команда)
	ПодтвердитьИзмененияНаСервере();
КонецПроцедуры

#КонецОбласти