
#Область ОбработчикиСобытйФормы

&НаКлиенте
Процедура УчастникиПроектаСотрудникПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.УчастникиПроекта.ТекущиеДанные;
	
	Совпадений = 0;
	
	Для Каждого ЭлементТаблицы Из Объект.УчастникиПроекта Цикл 
		
		Если ЭлементТаблицы.Сотрудник = ТекущиеДанные.Сотрудник Тогда 
			Совпадений = Совпадений + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Совпадений > 1 Тогда 
		
		Объект.УчастникиПроекта.Удалить(ТекущиеДанные);
		//Объект.УчастникиПроекта.Добавить();
		
		ВызватьИсключение("Данный сотрудник уже задействован в проекте!");		
		
	КонецЕсли;
	
	НужныйОтдел = ТекущиеДанные.Сотрудник.Отдел;
	ТекущиеДанные.Отдел = НужныйОтдел;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Заголовок = Объект.Наименование;
	
	Если ЗначениеЗаполнено(Объект.Наименование) Тогда
		
		Элементы.Наименование.Видимость = Ложь;
		Элементы.ОтредактироватьНазвание.Видимость = Истина;
		Элементы.ФормаПодтвердитьИзменения.Видимость = Ложь;
		
	КонецЕсли;
	
	ЭтапПроектаПриИзмененииНаСервере();
		
КонецПроцедуры

